# Copy this file to .env and fill in your key. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model IDs are read from here, change them if Google renames a model.
# If the primary model fails, the fallback is tried, then built-in template text.
GEMINI_MODEL=gemini/gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
